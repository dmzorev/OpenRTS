<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <Target Name="RequireStandaloneCore" BeforeTargets="CollectPackageReferences;ResolveProjectReferences">
    <Error Condition="'@(ProjectReference)' != '' Or '@(PackageReference)' != '' Or '@(Reference)' != ''" Text="OpenRTS.Core must build without external dependencies." />
  </Target>
</Project>
